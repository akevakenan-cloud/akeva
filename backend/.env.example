# Copy to .env and fill in. Every variable is prefixed AKEVA_.
AKEVA_ENV=development
AKEVA_MONGO_URI=mongodb://localhost:27017
AKEVA_MONGO_DB=akeva

# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
AKEVA_JWT_SECRET=
AKEVA_OTP_PEPPER=

# Document encryption keys, "id:base64key" comma-separated. Generate a key with:
# python -c "from app.domain.crypto import generate_key;print(generate_key())"
AKEVA_STORAGE_KEYS=
AKEVA_STORAGE_CURRENT_KEY_ID=1
AKEVA_STORAGE_DIR=./storage

# SMS: console (dev only) | africastalking | twilio
AKEVA_SMS_PROVIDER=console
AKEVA_SMS_SENDER_ID=AKEVA
AKEVA_AFRICASTALKING_USERNAME=
AKEVA_AFRICASTALKING_API_KEY=
AKEVA_TWILIO_ACCOUNT_SID=
AKEVA_TWILIO_AUTH_TOKEN=
AKEVA_TWILIO_FROM_NUMBER=
# Recommended: a Messaging Service (MG...) so Twilio picks a valid sender per country.
AKEVA_TWILIO_MESSAGING_SERVICE_SID=

# WhatsApp login codes (Twilio). Needs a WhatsApp sender approved in Twilio and an
# "authentication" content template per language (HX... SIDs from Content Template Builder).
AKEVA_WHATSAPP_ENABLED=false
AKEVA_TWILIO_WHATSAPP_FROM=
AKEVA_TWILIO_WHATSAPP_CONTENT_SID_FR=
AKEVA_TWILIO_WHATSAPP_CONTENT_SID_EN=
# Countries that get WhatsApp first, e.g. while an SMS sender ID awaits registration.
# Remove a country once its "AKEVA" sender ID is approved.
AKEVA_OTP_WHATSAPP_FIRST_COUNTRIES=CM,CG

AKEVA_CORS_ORIGINS=["http://localhost:3000"]
AKEVA_TRUST_PROXY_HEADERS=false
AKEVA_MAPBOX_PUBLIC_TOKEN=
